# Copy this file to .env.local and fill in both values from your Supabase project
# (Project Settings -> API Keys, or the "Connect" button at the top of the dashboard).
# Without them the app still runs, but only saves progress on the device.
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_KEY=paste-your-publishable-or-anon-key-here
